# Copy to .env and fill locally. Never commit .env.

# Required for mainnet-beta reads and sends.
SOLANA_RPC_URL=

# Exactly one source private key env var must be set.
# Use only for a purpose-funded airdrop hot wallet, never a treasury wallet.
SOURCE_PRIVATE_KEY_BASE58=
# SOURCE_PRIVATE_KEY_BASE64=

# Optional future indexed holder discovery provider.
SOLSCAN_API_KEY=
